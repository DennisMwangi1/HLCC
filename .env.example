# Andishi (local stack: docker compose in andishixkikapu)
VITE_ANDISHI_API_URL=http://localhost:8091
VITE_ANDISHI_SITE_KEY=pk_live_your_publishable_key
# The studio that may frame this site for Content > Edit content
VITE_ANDISHI_STUDIO_ORIGIN=http://localhost:8080

# Staging: put these in .env.staging.local and run npm run dev:staging (port 5174)
# VITE_ANDISHI_API_URL=<staging Site API address, from Developers > Overview > Connection>
# VITE_ANDISHI_SITE_KEY=pk_live_your_staging_key
# VITE_ANDISHI_STUDIO_ORIGIN=https://studio-staging.andishi.site
